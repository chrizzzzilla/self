<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Eingebauter Browser fuer DRM-freie Buch-Shops -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+: sichtbar machen, damit Self die Tolino-App finden/starten kann -->
    <queries>
        <package android:name="com.mytolino.app" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="market" />
        </intent>
    </queries>

    <application>
        <!--
            Eigene Activity fuer den Reader: Readium liefert den EPUB-Navigator als Fragment.
            configChanges: Drehen des Geraets baut die Activity nicht neu auf,
            der Navigator passt das Layout (z. B. Doppelspalte im Querformat) selbst an.
        -->
        <activity
            android:name="com.chrizzzzilla.self.reader.ReaderActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|keyboard|navigation"
            android:theme="@style/Theme.Self.Reader" />
    </application>
</manifest>
